ARG BASE_IMAGE=agent-develop:predictor-base
FROM ${BASE_IMAGE}
RUN pip install --no-deps onnxruntime==1.22.1 coloredlogs==15.0.1 humanfriendly==10.0 flatbuffers==25.12.19 sympy==1.14.0 mpmath==1.3.0
COPY runtime/ /app/runtime/
COPY predictors/ /app/predictors/
RUN python -c "import hashlib,json;from pathlib import Path;p=Path('/app/predictors');e=p/'encoder';m=json.loads((e/'provenance.json').read_text());assert all((e/n).is_file() and hashlib.sha256((e/n).read_bytes()).hexdigest()==h for n,h in m['files'].items()), 'Run evaluation.download_encoder before building';assert all(json.loads((p/(n+'.json')).read_text())['mode']==n for n in ('numeric','embedding'))"
ENV OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
