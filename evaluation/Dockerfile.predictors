ARG BASE_IMAGE=agent-develop:predictor-base
FROM ${BASE_IMAGE}
RUN pip install --no-deps onnxruntime==1.22.1 coloredlogs==15.0.1 humanfriendly==10.0 flatbuffers==25.12.19 sympy==1.14.0 mpmath==1.3.0
COPY runtime/ /app/runtime/
COPY predictors/ /app/predictors/
ENV OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
