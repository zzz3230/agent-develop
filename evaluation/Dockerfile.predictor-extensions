FROM agent-develop:predictors-checked
COPY runtime/ /app/runtime/
COPY predictors/*.json /app/predictors/
COPY predictors/encoder-strong/ /app/predictors/encoder-strong/
RUN python -c "import hashlib,json;from pathlib import Path;e=Path('/app/predictors/encoder-strong');m=json.loads((e/'provenance.json').read_text());assert all((e/n).is_file() and hashlib.sha256((e/n).read_bytes()).hexdigest()==h for n,h in m['files'].items()), 'Run evaluation.download_encoder --strong before building'"
