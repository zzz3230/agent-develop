FROM agent-develop:main-candidate
RUN pip install --no-cache-dir catboost==1.2.10
COPY runtime/predictor.py runtime/task_queue.py /app/runtime/
COPY predictors/catboost_structural_success.cbm predictors/catboost_structural_cost.cbm predictors/catboost_large_success.cbm predictors/catboost_large_cost.cbm predictors/catboost_large_mae_cost.cbm predictors/catboost_large_huber_cost.cbm predictors/catboost_instruction_success.cbm predictors/catboost_instruction_cost.cbm /app/predictors/
RUN python -c "from catboost import CatBoostClassifier,CatBoostRegressor;from pathlib import Path;p=Path('/app/predictors');a=CatBoostClassifier();a.load_model(str(p/'catboost_structural_success.cbm'));b=CatBoostRegressor();b.load_model(str(p/'catboost_structural_cost.cbm'));c=CatBoostClassifier();c.load_model(str(p/'catboost_large_success.cbm'));d=CatBoostRegressor();d.load_model(str(p/'catboost_large_cost.cbm'));e=CatBoostRegressor();e.load_model(str(p/'catboost_large_mae_cost.cbm'));f=CatBoostRegressor();f.load_model(str(p/'catboost_large_huber_cost.cbm'));g=CatBoostClassifier();g.load_model(str(p/'catboost_instruction_success.cbm'));h=CatBoostRegressor();h.load_model(str(p/'catboost_instruction_cost.cbm'));assert len(a.feature_names_)==len(b.feature_names_)==len(c.feature_names_)==len(d.feature_names_)==len(e.feature_names_)==len(f.feature_names_)==18;assert len(g.feature_names_)==len(h.feature_names_)==22"
